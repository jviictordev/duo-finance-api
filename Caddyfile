{$CADDY_SITE} {
	encode gzip

	request_body {
		max_size 20MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	# SSE: sem buffer, sem timeout de resposta
	@sse path /stream*
	handle @sse {
		reverse_proxy api:3333 {
			flush_interval -1
			transport http {
				response_header_timeout 24h
			}
		}
	}

	handle {
		reverse_proxy api:3333
	}
}
