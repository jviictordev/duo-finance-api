# Copie para .env.production no VPS (NÃO versionar). Usado pelo docker-compose.prod.yml.

NODE_ENV=production
PORT=3333

# domínio(s) do front em produção
CORS_ORIGINS=https://app.duofinance.app,capacitor://localhost,https://localhost

# host "postgres" = nome do serviço no docker-compose.prod.yml
DATABASE_URL=postgresql://duo:SENHA_FORTE@postgres:5432/duo_finance?schema=public
POSTGRES_USER=duo
POSTGRES_PASSWORD=SENHA_FORTE
POSTGRES_DB=duo_finance

REDIS_URL=redis://redis:6379

# gere: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
STREAM_TOKEN_TTL=60s

# Cloudflare R2 (ou S3/MinIO). Obrigatório em produção.
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=duo-finance
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=https://cdn.duofinance.app

# domínio que o Caddy vai emitir TLS
CADDY_SITE=api.duofinance.app

MAIL_FROM="Duo Finance <no-reply@duofinance.app>"
MAIL_TRANSPORT=console
