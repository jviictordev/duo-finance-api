# Deploy via Docker/VPS: copie para .env.production no servidor (NÃO versionar).
# Usado pelo docker-compose.prod.yml.
# (No deploy pela Vercel não há arquivo — as envs vão no painel; ver DEPLOY.md.)

NODE_ENV=production
PORT=3333

# domínio(s) do front em produção
CORS_ORIGINS=https://SEU-FRONT.exemplo.app,capacitor://localhost,https://localhost

# host "postgres" = nome do serviço no docker-compose.prod.yml
DATABASE_URL=postgresql://duo:TROQUE_ESTA_SENHA@postgres:5432/duo_finance?schema=public
DIRECT_URL=postgresql://duo:TROQUE_ESTA_SENHA@postgres:5432/duo_finance?schema=public
POSTGRES_USER=duo
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=duo_finance

REDIS_URL=redis://redis:6379

# gere: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
STREAM_TOKEN_TTL=60s

# Storage de anexos: sem token → disco local no volume `storage`. Para não
# perder anexos, use um Blob Store da Vercel (funciona fora da Vercel também):
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# domínio que o Caddy vai emitir TLS
CADDY_SITE=api.exemplo.app

MAIL_FROM="Duo Finance <no-reply@duofinance.app>"
MAIL_TRANSPORT=console
