# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3333
# origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:8100,capacitor://localhost,https://localhost,ionic://localhost

# ─── Banco ─────────────────────────────────────────────
DATABASE_URL=postgresql://duo:duo@localhost:5432/duo_finance?schema=public

# ─── Redis (pub/sub do SSE + rate limit + filas) ───────
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────
# gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-isto-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=troque-isto-tambem
JWT_REFRESH_TTL=30d
# token efêmero usado só para abrir o stream SSE
STREAM_TOKEN_TTL=60s

# ─── Storage de anexos (S3 compatível: R2 / MinIO) ─────
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=duo-finance
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/duo-finance

# ─── E-mail (convites) — placeholder ───────────────────
MAIL_FROM="Duo Finance <no-reply@duofinance.app>"
MAIL_TRANSPORT=console
