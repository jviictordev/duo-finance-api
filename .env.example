# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3333
# origens permitidas no CORS (separadas por vírgula)
# dev: 8100 (ionic serve), 4200 (ng serve), capacitor://localhost etc. (device iOS)
# prod: adicionar o domínio do front (ex.: https://app.duofinance.app)
CORS_ORIGINS=http://localhost:8100,http://localhost:4200,capacitor://localhost,https://localhost,ionic://localhost

# ─── Banco ─────────────────────────────────────────────
DATABASE_URL=postgresql://duo:duo@localhost:5432/duo_finance?schema=public
# conexão direta (sem pooler) usada pelo `prisma migrate`. Local: igual à de cima.
# Na Vercel: DATABASE_URL = string "-pooler" do Neon, DIRECT_URL = string direta.
DIRECT_URL=postgresql://duo:duo@localhost:5432/duo_finance?schema=public

# ─── Redis (pub/sub do SSE + rate limit + filas) ───────
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────
# gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-isto-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=troque-isto-tambem
JWT_REFRESH_TTL=30d
# token efêmero usado só para abrir o stream SSE
STREAM_TOKEN_TTL=60s

# ─── Storage de anexos (recibos) ───────────────────────
# Com o token → Vercel Blob. Sem ele → disco local (dev; some a cada deploy).
# O token é gerado ao criar um Blob Store no painel da Vercel.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ─── E-mail (convites) ─────────────────────────────────
# console = imprime no log e o token do convite volta na resposta da API
MAIL_FROM="Duo Finance <no-reply@duofinance.app>"
MAIL_TRANSPORT=console
